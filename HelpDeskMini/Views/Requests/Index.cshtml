@model List<HelpDeskMini.Models.HelpRequest>
@{
    ViewData["Title"] = "Заявки";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Заявки за техническа помощ</h1>
        <p class="text-muted mb-0">Преглед и управление на техническите проблеми.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Нова заявка</a>
</div>

<form asp-action="Index" method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label" for="search">Търсене по заглавие</label>
            <input id="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Напр. Няма интернет" />
        </div>
        <div class="col-md-4">
            <label class="form-label" for="status">Филтър по статус</label>
            <select id="status" name="status" class="form-select">
                <option value="">Всички статуси</option>
                <option value="Нова" selected="@(ViewBag.Status == "Нова")">Нова</option>
                <option value="В процес" selected="@(ViewBag.Status == "В процес")">В процес</option>
                <option value="Решена" selected="@(ViewBag.Status == "Решена")">Решена</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-success">Търси</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Изчисти</a>
        </div>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Няма намерени заявки. Добави нова заявка или промени критериите за търсене.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Заглавие</th>
                    <th>Кабинет</th>
                    <th>Приоритет</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td class="fw-semibold">@request.Title</td>
                        <td>@request.Room</td>
                        <td>
                            <span class="badge @(request.Priority == "Висок" ? "text-bg-danger" : request.Priority == "Среден" ? "text-bg-warning" : "text-bg-secondary")">@request.Priority</span>
                        </td>
                        <td>
                            <span class="badge @(request.Status == "Решена" ? "text-bg-success" : request.Status == "В процес" ? "text-bg-info" : "text-bg-primary")">@request.Status</span>
                        </td>
                        <td class="text-nowrap">
                            <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-sm btn-outline-info">Детайли</a>
                            <a asp-action="Edit" asp-route-id="@request.Id" class="btn btn-sm btn-outline-primary">Редакция</a>
                            <a asp-action="Delete" asp-route-id="@request.Id" class="btn btn-sm btn-outline-danger">Изтрий</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

