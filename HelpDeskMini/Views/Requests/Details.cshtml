@model HelpDeskMini.Models.HelpRequest
@{
    ViewData["Title"] = "Подробности";
}
<h1>Подробности за заявката</h1>

<div class="card details-card">
    <div class="card-body">
        <div class="mb-3">
            <div class="text-muted small">Заглавие</div>
            <h3>@Model.Title</h3>
        </div>
        <hr />
        <div class="row mb-3">
            <div class="col-sm-3 text-muted">Кабинет</div>
            <div class="col-sm-9">@Model.Room</div>
        </div>
        <div class="row mb-3">
            <div class="col-sm-3 text-muted">Описание</div>
            <div class="col-sm-9 description-text">@Model.Description</div>
        </div>
        <div class="row mb-3">
            <div class="col-sm-3 text-muted">Приоритет</div>
            <div class="col-sm-9">@Model.Priority</div>
        </div>
        <div class="row">
            <div class="col-sm-3 text-muted">Статус</div>
            <div class="col-sm-9">@Model.Status</div>
        </div>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Редактирай</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Назад към списъка</a>
</div>
